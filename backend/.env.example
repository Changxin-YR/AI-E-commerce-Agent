# Create .env locally. Use the same credentials as your root .env.
SOLOOPS_DATABASE_URL=mysql+pymysql://soloops:replace-with-local-password@127.0.0.1:3307/soloops?charset=utf8mb4
SOLOOPS_COOKIE_SECURE=false
# Optional, disabled until the seller explicitly enables a configured provider and budget.
SOLOOPS_MODEL_ENABLED=false
SOLOOPS_MODEL_PROVIDER=openai_responses
SOLOOPS_MODEL_API_KEY=
SOLOOPS_MODEL_NAME=
# R2 test mail is disabled by default. Bind one owned shop and a seller-controlled test mailbox.
SOLOOPS_OUTBOUND_ENABLED=false
SOLOOPS_OUTBOUND_API_KEY=
# SOLOOPS_OUTBOUND_OWNER_ID=1
# SOLOOPS_OUTBOUND_SHOP_ID=1
# SOLOOPS_OUTBOUND_DOMAIN_ID=verified-domain-uuid-from-resend
# SOLOOPS_OUTBOUND_SENDER=owner@your-verified-domain.example
# SOLOOPS_OUTBOUND_TEST_RECIPIENT=your-own-test-mailbox@example.com
# Set verified USD per 1M token rates for the selected model; no assumed/free rates.
# SOLOOPS_MODEL_INPUT_USD_PER_MILLION=
# SOLOOPS_MODEL_OUTPUT_USD_PER_MILLION=
# SOLOOPS_MODEL_COST_NOTE=按部署费率估算，以供应商账单为准
# Alibaba Beijing: set provider=dashscope_chat and model=qwen3.7-flash.
# Its fixed official Chat Completions endpoint requires a Beijing workspace key.
# Set USD budget rates explicitly from current catalogue prices and a documented conversion.
SOLOOPS_TRUSTED_HOSTS=["localhost","127.0.0.1"]
SOLOOPS_TRUSTED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
