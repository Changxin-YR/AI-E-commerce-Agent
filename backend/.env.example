# Create .env locally. Use the same credentials as your root .env.
SOLOOPS_DATABASE_URL=mysql+pymysql://soloops:replace-with-local-password@127.0.0.1:3307/soloops?charset=utf8mb4
SOLOOPS_COOKIE_SECURE=false
SOLOOPS_TRUSTED_HOSTS=["localhost","127.0.0.1"]
SOLOOPS_TRUSTED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
